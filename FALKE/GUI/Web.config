  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
  </system.web>
  <!-- ni el connection string ni la key del aes deberian ir aca en un sistema realista, pero para facilitar el transporte del sistema desde mi hogar hasta la universidad se almacena en este archivo, en uno realista, deberia ir en una variable de entorno del servidor -->
  <connectionStrings>
    <add name="FalkeDB" connectionString="Server=.;Database=FalkeDB;Trusted_Connection=True;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="FALKE_AES_KEY" value="dNQ1lGyAqhJVRIJqeW0kayle0DPRf+FeMMNuHJ76m/o=" />
  </appSettings>
</configuration>