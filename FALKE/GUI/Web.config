<?xml version="1.0" encoding="utf-8"?>
<!--
  Para obtener más información sobre cómo configurar la aplicación ASP.NET, visite
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
	<system.web>
		<compilation debug="true" targetFramework="4.7.2" />
		<httpRuntime targetFramework="4.7.2" />
	</system.web>
	<!-- ni el connection string ni la key del aes deberian ir aca en un sistema realista, pero para facilitar el transporte del sistema desde mi hogar hasta la universidad se almacena en este archivo, en uno realista, deberia ir en una variable de entorno del servidor -->
	<connectionStrings>
		<add name="FalkeDB" connectionString="Server=.;Database=FalkeDB;Trusted_Connection=True;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
		<!-- Base para armar los links de los mails (activacion / recuperacion). Debe salir de aca
		     y no de Request.Url, para que no se pueda envenenar el link con el header Host. -->
		<add key="FALKE_BASE_URL" value="http://localhost:53192/" />
		<add key="FALKE_AES_KEY" value="dNQ1lGyAqhJVRIJqeW0kayle0DPRf+FeMMNuHJ76m/o=" />
		<!-- acceso de emergencia (break-glass access): permite entrar con acceso total si la tabla de usuarios está corrupta o inaccesible. Se guarda fuera de la base a propósito, para no depender del recurso que puede fallar. En producción iría en algun lugar externo y se rotaria constantemente. -->
		<add key="FALKE_EMERGENCY_USER" value="admin" />
		<!-- SHA-256 de "admin". El codigo (Usuario_TLL) lee FALKE_EMERGENCY_HASH. -->
		<add key="FALKE_EMERGENCY_HASH" value="8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918"/>
	</appSettings>
</configuration>